{
  "name": "mobius",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Mobius, the AI workspace. Every app. One agent.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:core && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @mobius/desktop",
    "build": "npm run build -w @mobius/desktop",
    "e2e": "npm run build -w @mobius/desktop && cargo build --workspace --bins && npm run e2e -w @mobius/desktop",
    "build:core": "cargo build -p mobius-cored",
    "test:core": "cargo test --workspace",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/check-generated.mjs",
    "app": "npm run app -w @mobius/desktop --",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
