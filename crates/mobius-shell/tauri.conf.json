{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobius",
  "version": "0.1.0",
  "identifier": "app.mobius.shell",
  "build": {
    "frontendDist": "../../apps/desktop/dist/tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' media: http://media.localhost blob:; connect-src 'self' ipc: http://ipc.localhost media:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Mobius",
    "shortDescription": "Mobius",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRjREMEZCNDk4MTI4QzkKUldUSktJRkorOUQwTCtLcHhpWUI5QlpreTRWajc2N3dWeGVXRklmUXlmcnVxYklWQ3dJV2kvazkK",
      "endpoints": [
        "https://github.com/BevActual/mobius/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
